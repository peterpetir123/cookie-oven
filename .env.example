# Cookie Oven is designed to run with no secrets.
#
# The whole point of the external-signer architecture is that the server never holds a key, so there
# is no COOKIE_PRIVATE_KEY here and there should never be one. If you find yourself adding it, the
# architecture has been broken somewhere — see README § "The design decision that matters".

# Required: tells cookie-mcp not to expect a key in the process.
COOKIE_SIGNER=external

# Optional. Defaults are already Cookie Chain's, so these only need setting to point elsewhere.
# COOKIE_RPC_URL=https://rpc.cookiescan.io
# COOKIE_WALLET_ADDRESS=

# Optional: pin CORS if you fork this and host it on a known origin.
# COOKIE_MCP_CORS_ORIGIN=https://your-deployment.vercel.app

# Optional local sidecar port.
# PORT=8790
